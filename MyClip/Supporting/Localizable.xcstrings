            "state": "translated",
            "value": "· Finde mit MyClip meine aktuellen Projektnotizen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "· Use MyClip to find my recent project notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "· Usa MyClip para buscar mis notas de proyecto recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "· Utilise MyClip pour retrouver mes notes de projet récentes."
          }
        },
        "ja": {
          "stringUnit": {
