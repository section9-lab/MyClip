    "读取桌面与文档中的文件，帮助首次整理知识库内容；不授权也可继续使用": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest Dateien auf dem Schreibtisch und in „Dokumente“, um die erste Organisation zu unterstützen. Geht auch ohne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads files in Desktop and Documents to help build your library the first time. MyClip works without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee archivos del escritorio y de documentos para ayudar en la primera organización de la base de conocimiento; puedes seguir usándola sin conceder este permiso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les fichiers du bureau et des documents pour faciliter la première organisation. MyClip fonctionne sans cette autorisation."
          }
