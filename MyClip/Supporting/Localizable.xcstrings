    "试试其他关键词，或从边栏浏览已有内容。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche andere Suchbegriffe oder stöbere in der Seitenleiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try other keywords, or browse existing content from the sidebar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otras palabras clave o explora el contenido desde la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez d'autres mots-clés ou parcourez le contenu existant depuis la barre latérale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
