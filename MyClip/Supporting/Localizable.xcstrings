    },
    "%@ 自带 ACP 支持，无需连接组件；请先安装 %@ 命令行。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ unterstützt ACP direkt, eine Verbindungskomponente ist nicht nötig. Installiere zuerst das %2$@-Befehlszeilentool."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has built-in ACP support and needs no connector. Install the %2$@ command line tool first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ incluye compatibilidad con ACP y no necesita componente de conexión; instala primero la línea de comandos de %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ prend en charge ACP nativement, sans composant de connexion ; installez d'abord la ligne de commande %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は ACP をネイティブサポートしているため、接続コンポーネントは不要です。先に %2$@ コマンドラインをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에는 ACP 지원이 내장되어 있어 연결 구성요소가 필요하지 않습니다. 먼저 %2$@ 명령어 라인을 설치하십시오."
          }
        }
      }
    },
    "%@ 配置必须是 JSON 对象，原文件未改动。": {
      "localizations": {
        "de": {
