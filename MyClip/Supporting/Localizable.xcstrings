    "%@ 已有其他服务使用 myclip 名称，请先在客户端中重命名该服务。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ verwendet bereits ein anderer Dienst den Namen „myclip“. Benenne diesen Dienst zuerst im Client um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already has another server named myclip. Rename that server in the client first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@ ya hay otro servicio con el nombre myclip; cámbiale el nombre en el cliente antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise déjà le nom myclip pour un autre service ; renommez d'abord ce service dans le client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ では別のサービスが myclip という名前を使用しています。先にクライアント側でそのサービスの名前を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이미 myclip 이름을 사용하는 다른 서비스가 있습니다. 먼저 클라이언트에서 해당 서비스의 이름을 변경하십시오."
          }
        }
      }
    },
