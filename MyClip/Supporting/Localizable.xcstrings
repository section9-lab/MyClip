        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 키워드로 검색하거나 사이드바에서 기존 내용을 둘러보십시오."
          }
        }
      }
    },
    "试试其他关键词，或清除搜索查看全部截图。": {
      "localizations": {
        "de": {
          "stringUnit": {
