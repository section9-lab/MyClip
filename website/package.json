{
  "name": "myclip-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx src/build.tsx && tailwindcss -i src/styles.css -o dist/MyClip/assets/site.css --minify",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "verify": "tsx scripts/verify.ts",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.13.0",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.62.0",
    "marked": "^18.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
